# Copy to .env and fill in. .env itself is gitignored.

# Which LLM backend to use: "ollama" (local dev) or "groq" (cloud deploy)
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_HOST=http://localhost:11434

# Groq (free tier — get a key at https://console.groq.com)
GROQ_API_KEY=

# MinIO (local data lake)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SEC EDGAR requires a contact email in the User-Agent header by policy
SEC_EDGAR_CONTACT_EMAIL=your_email@example.com
